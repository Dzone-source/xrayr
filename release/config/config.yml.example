Log:
  Level: warning
  AccessPath: # /etc/XrayR/access.log
  ErrorPath: # /etc/XrayR/error.log
DnsConfigPath: # /etc/XrayR/dns.json
RouteConfigPath: # /etc/XrayR/route.json
InboundConfigPath: # /etc/XrayR/custom_inbound.json
OutboundConfigPath: # /etc/XrayR/custom_outbound.json
ConnectionConfig:
  Handshake: 8
  ConnIdle: 600
  # Upload speed tests: keep one-way open; also avoid remove+add on limit sync.
  UplinkOnly: 3600
  DownlinkOnly: 3600
  BufferSize: 1024
Nodes:
  # DPanel Trojan (Hiddify). Đổi NodeType/Cert theo node thật.
  - PanelType: "SSpanel"
    ApiConfig:
      ApiHost: "https://panel.example.com"
      ApiKey: "same-as-panel-muKey"
      NodeID: 1
      NodeType: Trojan # Trojan | V2ray | Vmess | Vless | Shadowsocks
      Timeout: 30
      EnableVless: false
      VlessFlow: "xtls-rprx-vision"
      SpeedLimit: 0
      DeviceLimit: 0
      RuleListPath: # /etc/XrayR/rulelist
      DisableCustomConfig: false
    ControllerConfig:
      ListenIP: 0.0.0.0
      SendIP: 0.0.0.0
      UpdatePeriodic: 60
      EnableDNS: false
      DNSType: AsIs
      EnableProxyProtocol: false
      EnableTFO: true # Hiddify-Manager style TCP Fast Open
      DisableSniffing: false
      AutoSpeedLimitConfig:
        Limit: 0
        WarnTimes: 0
        LimitSpeed: 0
        LimitDuration: 0
      GlobalDeviceLimitConfig:
        Enable: false
        RedisNetwork: tcp
        RedisAddr: 127.0.0.1:6379
        RedisUsername:
        RedisPassword: ""
        RedisDB: 0
        Timeout: 5
        Expiry: 60
      EnableFallback: false
      DisableLocalREALITYConfig: true
      EnableREALITY: false
      CertConfig:
        # Trojan bắt buộc TLS. Dùng file / http / dns — không dùng none.
        CertMode: file
        CertDomain: "node.example.com"
        CertFile: /etc/XrayR/cert/node.example.com.crt
        KeyFile: /etc/XrayR/cert/node.example.com.key
        Provider: cloudflare
        Email: admin@example.com
        DNSEnv:
          CLOUDFLARE_DNS_API_TOKEN: ""
