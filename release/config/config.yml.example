Log:
  Level: warning # none, error, warning, info, debug
  AccessPath: # /etc/XrayR/access.log
  ErrorPath: # /etc/XrayR/error.log
DnsConfigPath: # /etc/XrayR/dns.json
RouteConfigPath: # /etc/XrayR/route.json
InboundConfigPath: # /etc/XrayR/custom_inbound.json
OutboundConfigPath: # /etc/XrayR/custom_outbound.json
ConnectionConfig:
  Handshake: 8
  ConnIdle: 300
  UplinkOnly: 5
  DownlinkOnly: 8
  BufferSize: 512
Nodes:
  # DPanel / SSPanel-UIM (Hiddify-stable defaults). For Xboard UniProxy use PanelType: NewV2board.
  - PanelType: "SSpanel"
    ApiConfig:
      ApiHost: "https://panel.example.com"
      ApiKey: "same-as-panel-muKey"
      NodeID: 1
      NodeType: V2ray # V2ray, Vmess, Vless, Shadowsocks, Trojan, Shadowsocks-Plugin
      Timeout: 30
      # Prefer panel custom_config enable_vless; set true if all V2ray nodes are VLESS.
      EnableVless: true
      VlessFlow: "xtls-rprx-vision"
      SpeedLimit: 0
      DeviceLimit: 0
      RuleListPath: # /etc/XrayR/rulelist
      DisableCustomConfig: false
    ControllerConfig:
      ListenIP: 0.0.0.0
      SendIP: 0.0.0.0
      UpdatePeriodic: 60
      EnableDNS: false
      DNSType: AsIs
      EnableProxyProtocol: false
      AutoSpeedLimitConfig:
        Limit: 0
        WarnTimes: 0
        LimitSpeed: 0
        LimitDuration: 0
      GlobalDeviceLimitConfig:
        Enable: false
        RedisNetwork: tcp
        RedisAddr: 127.0.0.1:6379
        RedisUsername:
        RedisPassword: ""
        RedisDB: 0
        Timeout: 5
        Expiry: 60
      EnableFallback: false
      # Panel owns REALITY keys via custom_config (Xboard-Node style).
      DisableLocalREALITYConfig: true
      EnableREALITY: false
      CertConfig:
        CertMode: none # none for REALITY; file/http/tls/dns for classic TLS
        CertDomain: "node.example.com"
        CertFile: /etc/XrayR/cert/node.example.com.cert
        KeyFile: /etc/XrayR/cert/node.example.com.key
        Provider: cloudflare
        Email: admin@example.com
        DNSEnv:
          CLOUDFLARE_DNS_API_TOKEN: ""
